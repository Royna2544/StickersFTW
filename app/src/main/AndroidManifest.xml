<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Pack conversion runs minutes, not seconds, and has to survive the
         user leaving the app; dataSync rather than shortService, whose three
         minute cap it would routinely blow through. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <queries>
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.messenger.web" />
        <!-- Telegram X: Telegram's own official alternative client. -->
        <package android:name="org.thunderdog.challegram" />
        <!-- Any app registered to handle Telegram's tg:// deep-link scheme
             is a Telegram-family client; this discovers third-party
             forks/mods by their own real package name and app label
             instead of hardcoding each one. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tg" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application
        android:name=".StickersFtwApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.StickersFTW">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".operation.PackOperationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name=".whatsapp.StickerContentProvider"
            android:authorities="${applicationId}.stickercontentprovider"
            android:exported="true"
            android:readPermission="com.whatsapp.sticker.READ" />
    </application>

</manifest>
